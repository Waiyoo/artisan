datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  EXTERNAL_LINK
}

enum MetricType {
  VIEW
  CONTACT_CLICK
  MEDIA_INTERACTION
  SEARCH_APPEARANCE
}

model AdminUser {
  id             String      @id @default(cuid())
  email          String      @unique
  username       String?     @unique
  passwordHash   String
  name           String
  role           Role        @default(ADMIN)
  failedAttempts Int         @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  sessions       Session[]
  auditLogs      AuditLog[]

  @@index([email])
  @@index([username])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

model investment {
  id             String             @id @default(cuid())
  name           String
  fullName       String?
  slug           String             @unique
  tagline        String?
  bio            String?            @db.Text
  location       String?
  status         String             @default("DRAFT") // PUBLISHED, DRAFT, TRASH
  isFeatured     Boolean            @default(false)
  isTrending     Boolean            @default(false)
  profileViews   Int                @default(0)
  isDeleted      Boolean            @default(false)
  
  // Custom Contact Fields
  customWhatsapp String?
  customEmail    String?
  customWebsite  String?

  // Relations
  categories     investmentCategory[]
  tags           investmentTag[]
  media          investmentMedia[]
  externalLinks  ExternalLink[]
  socialLinks    investmentsocialLink[]
  bookingContact BookingContact?
  metrics        investmentMetric[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  @@index([slug])
  @@index([status, isDeleted])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([location])
  @@index([profileViews])
  @@index([createdAt])
}

model Category {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  description String?
  investments     investmentCategory[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([slug])
}

model Tag {
  id        String      @id @default(cuid())
  name      String      @unique
  slug      String      @unique
  investments   investmentTag[]
  createdAt DateTime    @default(now())

  @@index([slug])
}

model investmentCategory {
  investmentId   String
  categoryId String
  investment     investment   @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([investmentId, categoryId])
}

model investmentTag {
  investmentId String
  tagId    String
  investment   investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([investmentId, tagId])
}

model investmentMedia {
  id           String    @id @default(cuid())
  investmentId     String
  investment       investment    @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  type         MediaType
  url          String    @db.Text
  thumbnailUrl String?   @db.Text
  title        String?
  description  String?
  provider     String?   // e.g., "YouTube", "Spotify", "SoundCloud", "Custom"
  mimeType     String?
  sizeBytes    Int?
  isPrimary    Boolean   @default(false)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([investmentId])
  @@index([type])
}

model ExternalLink {
  id        String   @id @default(cuid())
  investmentId  String
  investment    investment   @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  title     String
  url       String
  category  String?  @default("General")
  createdAt DateTime @default(now())

  @@index([investmentId])
}

model investmentsocialLink {
  id        String   @id @default(cuid())
  investmentId  String
  investment    investment   @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  platform  String   // e.g., "instagram", "spotify", "youtube", "tiktok", "twitter"
  url       String
  createdAt DateTime @default(now())

  @@index([investmentId])
}

model BookingContact {
  id            String   @id @default(cuid())
  investmentId      String   @unique
  investment        investment   @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  useDefault    Boolean  @default(true)
  customEmail   String?
  customPhone   String?  // WhatsApp formatted phone
  customWebsite String?
  customText    String?
  updatedAt     DateTime @updatedAt
}

model HomepageContent {
  id              String   @id @default(cuid())
  heroTitle       String   @default("Discover World-Class Public investments")
  heroSubtitle    String   @default("The definitive showcase for visionary public entertainment and art wealth.")
  heroBannerUrl   String?
  featuredHeading String   @default("Featured investments")
  trendingHeading String   @default("Trending Now")
  updatedAt       DateTime @updatedAt
}

model Banner {
  id             String   @id @default(cuid())
  title          String
  subtitle       String?
  description    String?
  imageUrl       String?
  linkUrl        String?
  ctaText        String?
  ctaDestination String?
  isActive       Boolean  @default(true)
  isPublished    Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model SiteSettings {
  id                    String   @id @default("default-site-settings")
  heroTitle             String   @default("Discover Exceptional Independent wealth")
  heroDescription       String   @default("Explore verified investments.")
  heroImage             String?
  ctaText               String   @default("Explore investments")
  ctaDestination        String   @default("/investments")
  introHeading          String   @default("Curated Excellence")
  introBody             String   @default("Connecting promoters, upcoming projects, and investors directly with verified wealth.")
  defaultWhatsapp       String?
  defaultEmail          String   @default("contact@ndegwainvestments.com")
  defaultWebsite        String?
  socialInstagram       String?
  socialTwitter         String?
  socialYoutube         String?
  socialSoundcloud      String?
  showPromotionalBanner Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model investmentMetric {
  id        String     @id @default(cuid())
  investmentId  String
  investment    investment     @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  eventType MetricType
  weight    Float      @default(1.0)
  ipHash    String?    // Anonymized/hashed IP to prevent rapid refresh abuse
  userAgent String?
  timestamp DateTime   @default(now())

  @@index([investmentId, timestamp])
  @@index([eventType, timestamp])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String   // e.g., "PAGE_VIEW", "investment_VIEW", "SEARCH", "CONTACT_CLICK"
  entityId  String?  // investmentId or categoryId
  metadata  String?  @db.Text // JSON string
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}

model AuditLog {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  details   String?   @db.Text
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@index([createdAt])
}

model NotificationSetting {
  id          String   @id @default(cuid())
  enabled     Boolean  @default(true)
  adminEmail  String?
  smtpHost    String?
  smtpPort    Int?
  smtpUser    String?
  smtpPass    String?
  updatedAt   DateTime @updatedAt
}
