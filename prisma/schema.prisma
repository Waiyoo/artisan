datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  EXTERNAL_LINK
}

enum MetricType {
  VIEW
  CONTACT_CLICK
  MEDIA_INTERACTION
  SEARCH_APPEARANCE
}

model AdminUser {
  id             String      @id @default(cuid())
  email          String      @unique
  username       String?     @unique
  passwordHash   String
  name           String
  role           Role        @default(ADMIN)
  failedAttempts Int         @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  sessions       Session[]
  auditLogs      AuditLog[]

  @@index([email])
  @@index([username])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

model investment {
  id             String                  @id @default(cuid())
  name           String
  fullName       String?
  slug           String                  @unique
  tagline        String?
  bio            String?                 @db.Text
  location       String?
  status         String                  @default("DRAFT")
  isFeatured     Boolean                 @default(false)
  isTrending     Boolean                 @default(false)
  profileViews   Int                     @default(0)
  isDeleted      Boolean                 @default(false)
  customWhatsapp String?
  customEmail    String?
  customWebsite  String?

  categories     investmentCategory[]
  tags           investmentTag[]
  media          investmentMedia[]
  externalLinks  ExternalLink[]
  socialLinks    investmentsocialLink[]
  bookingContact BookingContact?
  metrics        investmentMetric[]

  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?

  @@index([slug])
  @@index([status, isDeleted])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([location])
  @@index([profileViews])
  @@index([createdAt])
}

model Category {
  id          String               @id @default(cuid())
  name        String               @unique
  slug        String               @unique
  description String?
  investments investmentCategory[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([slug])
}

model Tag {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  investments investmentTag[]
  createdAt   DateTime       @default(now())

  @@index([slug])
}

model investmentCategory {
  investmentId String
  categoryId   String

  investment investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([investmentId, categoryId])
  @@index([categoryId])
}

model investmentTag {
  investmentId String
  tagId        String

  investment investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  tag         Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([investmentId, tagId])
  @@index([tagId])
}

model investmentMedia {
  id           String     @id @default(cuid())
  investmentId String
  investment   investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  type         MediaType
  url          String     @db.Text
  thumbnailUrl String?    @db.Text
  title        String?
  description  String?
  provider     String?
  mimeType     String?
  sizeBytes    Int?
  isPrimary    Boolean    @default(false)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([investmentId])
  @@index([type])
  @@index([investmentId, isPrimary])
  @@index([investmentId, sortOrder])
}

model ExternalLink {
  id           String     @id @default(cuid())
  investmentId String
  investment   investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  title        String
  url          String     @db.Text
  category     String?    @default("General")
  createdAt    DateTime   @default(now())

  @@index([investmentId])
}

model investmentsocialLink {
  id           String     @id @default(cuid())
  investmentId String
  investment   investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  platform     String
  url          String     @db.Text
  createdAt    DateTime   @default(now())

  @@index([investmentId])
}

model BookingContact {
  id            String     @id @default(cuid())
  investmentId  String     @unique
  investment    investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  useDefault    Boolean    @default(true)
  customEmail   String?
  customPhone   String?
  customWebsite String?
  customText    String?
  updatedAt     DateTime   @updatedAt
}

model HomepageContent {
  id              String   @id @default(cuid())
  heroTitle       String   @default("Discover Exceptional Investment Opportunities")
  heroSubtitle    String   @default("Explore carefully presented investment opportunities across diverse sectors.")
  heroBannerUrl   String?
  featuredHeading String   @default("Featured Investments")
  trendingHeading String   @default("Trending Investments")
  updatedAt       DateTime @updatedAt
}

model Banner {
  id             String   @id @default(cuid())
  title          String
  subtitle       String?
  description    String?
  imageUrl       String?
  linkUrl        String?
  ctaText        String?
  ctaDestination String?
  isActive       Boolean  @default(true)
  isPublished    Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model SiteSettings {
  id                    String   @id @default("default-site-settings")
  heroTitle             String   @default("Discover Exceptional Investment Opportunities")
  heroDescription       String   @default("Explore verified investment opportunities and projects.")
  heroImage             String?
  ctaText               String   @default("Explore Investments")
  ctaDestination        String   @default("/investment")
  introHeading          String   @default("Curated Investment Opportunities")
  introBody             String   @default("Discover investment opportunities, projects, and businesses presented through a professional digital platform.")
  defaultWhatsapp       String?
  defaultEmail          String?
  defaultWebsite        String?
  socialInstagram       String?
  socialTwitter         String?
  socialYoutube         String?
  socialLinkedin        String?
  showPromotionalBanner Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model investmentMetric {
  id           String      @id @default(cuid())
  investmentId String
  investment   investment  @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  eventType    MetricType
  weight       Float       @default(1.0)
  ipHash       String?
  userAgent    String?
  timestamp    DateTime    @default(now())

  @@index([investmentId, timestamp])
  @@index([eventType, timestamp])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String
  entityId  String?
  metadata  String?  @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@index([entityId])
}

model AuditLog {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  details   String?   @db.Text
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@index([createdAt])
}

model NotificationSetting {
  id         String   @id @default(cuid())
  enabled    Boolean  @default(true)
  adminEmail String?
  smtpHost   String?
  smtpPort   Int?
  smtpUser   String?
  smtpPass   String?
  updatedAt  DateTime @updatedAt
}